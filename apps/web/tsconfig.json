{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@n-uf/hypr-tiling": ["../../packages/hypr-tiling/index.ts"],
      "@n-uf/hypr-tiling/engine": ["../../packages/hypr-tiling/engine.ts"],
      "@n-uf/hypr-tiling/devtools": ["../../packages/hypr-tiling/devtools.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
